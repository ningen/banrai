{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "banrai",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "BETTER_AUTH_URL": "https://banrai.nngn.dev",
  },
  "routes": [
    {
      "pattern": "banrai.nngn.dev",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "banrai-db",
      "database_id": "f41c9178-ba2e-4bc8-a7bd-d4f9695b2177",
      "migrations_dir": "./migrations",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
}
