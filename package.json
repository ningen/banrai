{
  "name": "banrai",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS platform for cleaning service operators (air conditioner cleaning, house cleaning, etc.)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n worker,web -c blue,green \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:worker": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "check:types": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "check": "npm run lint && npm run fmt:check && npm run check:types && npm run test",
    "deploy": "npm run build:web && wrangler deploy",
    "deploy:dry-run": "npm run build:web && wrangler deploy --dry-run",
    "deploy:preview": "npm run build:web && wrangler deploy --env preview",
    "migrations:apply:local": "wrangler d1 migrations apply banrai-db --local",
    "migrations:apply:remote": "wrangler d1 migrations apply banrai-db --remote"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "better-auth": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.11.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.0",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "jiti": "^2.7.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "workerd@1.20260825.1": true,
    "esbuild@0.28.1": true
  }
}
